<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>StickAndPuck</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Raylib-cs" Version="8.1.0" />
  </ItemGroup>

  <!-- the game reads its assets next to the executable: shaders, models, kit atlases, ad strips, palette, club data -->
  <ItemGroup>
    <None Include="shaders/**;art/player/*.glb;art/player/*_64.png;art/ads/*.png;art/kits/*.png;art/scene/*.glb;art/scene/arena_meshes.json;art/palette/*.gpl;art/audio/*.wav;data/**/*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
