<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0</TargetFramework>
    <LangVersion>15</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>StickAndPuck</RootNamespace>
  </PropertyGroup>

  <!-- dotnet publish -r linux-x64 (or win-x64) makes one self-contained executable: the runtime, raylib
       and every asset below are packed inside and unpacked on first start (tools/publish.sh) -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>embedded</DebugType>
    <!-- the game reads its assets from disk, so extracting all content on first start is wanted, not legacy -->
    <NoWarn>$(NoWarn);NETSDK1244</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Raylib-cs" Version="8.1.0" />
  </ItemGroup>

  <!-- the game reads its assets next to the executable: shaders, models, kit atlases, ad strips, palette, club data -->
  <ItemGroup>
    <None Include="shaders/**;art/player/*.glb;art/player/*_64.png;art/ads/*.png;art/kits/*.png;art/kits/numbers/*.png;art/scene/ice_scratches.png;art/scene/*.glb;art/scene/arena_meshes.json;art/zamboni/*.glb;art/palette/*.gpl;art/ui/*.png;art/ui/font.fnt;art/ui/ui.json;art/audio/*.wav;data/**/*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
