<Project>
  <ItemGroup>
    <!-- Keep the build formatter in sync with CSharpier in dotnet-tools.json. -->
    <PackageReference Include="CSharpier.MsBuild" Version="1.3.0" PrivateAssets="all" />
    <!-- Analyzers applied to every project (PrivateAssets=all: analyzer-only, not a runtime dep). -->
    <PackageReference Include="Meziantou.Analyzer" Version="3.0.313" PrivateAssets="all" />
    <PackageReference Include="SonarAnalyzer.CSharp" Version="10.35.0.4138" PrivateAssets="all" />
  </ItemGroup>
</Project>
