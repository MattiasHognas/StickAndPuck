<Project Sdk="Microsoft.NET.Sdk">

  <!-- W52: the former SAP_SCENE self-tests, run with dotnet test (TUnit on Microsoft.Testing.Platform) -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0</TargetFramework>
    <LangVersion>15</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <RootNamespace>StickAndPuck.Tests</RootNamespace>
    <NoWarn>$(NoWarn);CS1591;NETSDK1057</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="TUnit" Version="1.74.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="$(RepoRoot)src/StickAndPuck.App/StickAndPuck.App.csproj" />
    <!-- tests may use null; only SAP0003 (a pattern on Maybe that always matches) applies here, see .editorconfig -->
    <ProjectReference Include="$(RepoRoot)analyzers/StickAndPuck.Analyzers/StickAndPuck.Analyzers.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>
