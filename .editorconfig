# File formatting stays consistent across editors. Analyzer options and severities
# use the installed SDK/package defaults except for the duplicate rules below.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4
tab_width = 4

[*.{csproj,props,targets,json,yml,yaml}]
indent_size = 2
tab_width = 2

[*.md]
trim_trailing_whitespace = false

[*.cs]

# Keep one analyzer for each confirmed overlap. Similar rules with different scopes
# retain their defaults; this is not a blanket suppression list for analyzer packages.
# Reference: https://github.com/meziantou/Meziantou.Analyzer/blob/main/docs/comparison-with-other-analyzers.md

# Method length: MA0051 owns this check; do not also report Sonar's line-count limit.
dotnet_diagnostic.S138.severity = none

# Types outside namespaces: MA0047 owns this check instead of Sonar's equivalent.
dotnet_diagnostic.S3903.severity = none

# Static members: CA1822 owns this check. MA0038/MA0041 are deprecated in its favor;
# S2325 reports the same methods as CA1822 in this solution.
dotnet_diagnostic.MA0038.severity = none
dotnet_diagnostic.MA0041.severity = none
dotnet_diagnostic.S2325.severity = none
