# StickAndPuck code style. The build enforces it: EnforceCodeStyleInBuild and
# TreatWarningsAsErrors are on in Directory.Build.props, so every rule below at
# warning breaks the build.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4
tab_width = 4

[*.{csproj,props,targets,json,yml,yaml}]
indent_size = 2
tab_width = 2

[*.md]
trim_trailing_whitespace = false

[*.cs]

# ---------------------------------------------------------------------------
# Language style (raised rules are build-breaking warnings)
# ---------------------------------------------------------------------------

# var: explicit for built-in types (int, float, bool, string), var for everything else
csharp_style_var_for_built_in_types = false:warning
csharp_style_var_when_type_is_apparent = true:warning
csharp_style_var_elsewhere = true:warning
dotnet_diagnostic.IDE0007.severity = warning # use var
dotnet_diagnostic.IDE0008.severity = warning # use explicit type

# Braces: required when a body spans more than one line; one-line bodies such as
# `if (done) return;` stay as they are (bracing all 1,600 of them adds 5,800 lines and
# pushes twelve methods over the MA0051 cap)
csharp_prefer_braces = when_multiline:warning
dotnet_diagnostic.IDE0011.severity = warning

# Switch: prefer switch expressions, and every switch statement has a default
# (switch expressions are already covered: CS8509 non-exhaustive is a warning, so an error here)
csharp_style_prefer_switch_expression = true:warning
dotnet_diagnostic.IDE0066.severity = warning # convert switch statement to expression
dotnet_diagnostic.S131.severity = warning    # switch statement without a default clause
# Populate switch flags every enum member a switch leaves to its default arm, and its fix adds
# arms that throw; listing every member is not a mechanical change, so these stay suggestions.
dotnet_diagnostic.IDE0010.severity = suggestion # populate switch statement
dotnet_diagnostic.IDE0072.severity = suggestion # populate switch expression

# Unused code
dotnet_diagnostic.IDE0005.severity = warning # unnecessary using directive
dotnet_diagnostic.IDE0035.severity = warning # unreachable code
dotnet_diagnostic.IDE0051.severity = warning # unused private member
dotnet_diagnostic.IDE0052.severity = warning # private member assigned but never read
dotnet_diagnostic.IDE0059.severity = warning # value assigned but never used
dotnet_diagnostic.IDE0060.severity = warning # unused parameter
csharp_style_unused_value_assignment_preference = discard_variable:warning
csharp_style_unused_value_expression_statement_preference = discard_variable:silent
dotnet_code_quality_unused_parameters = non_public:warning
dotnet_diagnostic.S1481.severity = warning # unused local
dotnet_diagnostic.S1144.severity = warning # unused private member
dotnet_diagnostic.S1172.severity = warning # unused parameter
dotnet_diagnostic.S1854.severity = warning # dead store

# Other preferences, left as suggestions (shown in the IDE, not enforced)
csharp_style_expression_bodied_methods = when_on_single_line:suggestion
csharp_style_expression_bodied_constructors = false:suggestion
csharp_style_expression_bodied_operators = when_on_single_line:suggestion
csharp_style_expression_bodied_properties = true:suggestion
csharp_style_expression_bodied_accessors = true:suggestion
csharp_style_expression_bodied_lambdas = true:suggestion
csharp_style_pattern_matching_over_is_with_cast_check = true:suggestion
csharp_style_pattern_matching_over_as_with_null_check = true:suggestion
csharp_style_prefer_using_declaration = true:suggestion
csharp_style_namespace_declarations = file_scoped:suggestion
dotnet_style_null_propagation = true:suggestion
dotnet_style_coalesce_expression = true:suggestion
dotnet_style_readonly_field = true:suggestion
dotnet_style_qualification_for_field = false:suggestion
dotnet_style_qualification_for_property = false:suggestion
dotnet_style_qualification_for_method = false:suggestion
dotnet_style_qualification_for_event = false:suggestion
dotnet_sort_system_directives_first = true

# Naming: PascalCase types and members, camelCase private fields (suggestion only)
dotnet_naming_rule.private_fields_camel_case.severity = suggestion
dotnet_naming_rule.private_fields_camel_case.symbols = private_fields
dotnet_naming_rule.private_fields_camel_case.style = camel_case
dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private
dotnet_naming_style.camel_case.capitalization = camel_case

# ---------------------------------------------------------------------------
# Third-party analyzers (Meziantou MA*, Sonar S*)
# ---------------------------------------------------------------------------

# Method length: MA0051 (60 lines / 40 statements) breaks the build; S138 is Sonar's duplicate
dotnet_diagnostic.MA0051.severity = warning
dotnet_diagnostic.S138.severity = none

# File name must match type: systems split one partial class over topic files
dotnet_diagnostic.MA0048.severity = none
# Type named like its namespace's last segment (namespace StickAndPuck.App.Camera + class Camera...)
dotnet_diagnostic.MA0049.severity = none
# Loop to LINQ: the sim runs 60 Hz loops; LINQ allocates
dotnet_diagnostic.S3267.severity = none
# unsafe blocks are raylib interop
dotnet_diagnostic.S6640.severity = none
# Culture: the game shows no culture-formatted text yet (W53 string table revisits this)
dotnet_diagnostic.MA0002.severity = none

# Kept visible as suggestions; ratchet to warning when a task cleans them up
dotnet_diagnostic.S125.severity = suggestion    # commented-out code
dotnet_diagnostic.S1066.severity = suggestion   # merge collapsible if
dotnet_diagnostic.S108.severity = suggestion    # empty block
dotnet_diagnostic.S1199.severity = suggestion   # nested code block
dotnet_diagnostic.S1643.severity = suggestion   # use StringBuilder
dotnet_diagnostic.S1871.severity = suggestion   # identical branches
dotnet_diagnostic.S1905.severity = suggestion   # redundant cast
dotnet_diagnostic.S1994.severity = suggestion   # for-loop condition
dotnet_diagnostic.S2234.severity = suggestion   # parameter order
dotnet_diagnostic.S2325.severity = suggestion   # make method static
dotnet_diagnostic.S2365.severity = suggestion   # property makes a collection copy
dotnet_diagnostic.S2486.severity = suggestion   # swallowed exception
dotnet_diagnostic.S3241.severity = suggestion   # return value never used
dotnet_diagnostic.S3358.severity = suggestion   # nested ternary
dotnet_diagnostic.S3881.severity = suggestion   # IDisposable pattern
dotnet_diagnostic.S3903.severity = suggestion   # type outside a named namespace
dotnet_diagnostic.S4136.severity = suggestion   # group method overloads
dotnet_diagnostic.S4144.severity = suggestion   # identical method bodies
dotnet_diagnostic.S5443.severity = suggestion   # shared temp directory
dotnet_diagnostic.S6608.severity = suggestion   # indexing over First/Last
dotnet_diagnostic.MA0008.severity = suggestion  # add StructLayoutAttribute
dotnet_diagnostic.MA0009.severity = suggestion  # regex timeout
dotnet_diagnostic.MA0016.severity = suggestion  # prefer collection abstraction
dotnet_diagnostic.MA0023.severity = suggestion  # RegexOptions.ExplicitCapture
dotnet_diagnostic.MA0046.severity = suggestion  # event delegate signature
dotnet_diagnostic.MA0047.severity = suggestion  # type outside a namespace
dotnet_diagnostic.MA0084.severity = suggestion  # local hides outer symbol
dotnet_diagnostic.MA0158.severity = suggestion  # use System.Threading.Lock
