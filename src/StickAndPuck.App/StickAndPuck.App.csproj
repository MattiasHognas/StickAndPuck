<Project>
  <!--
    StickAndPuck.App: the game. One project builds the desktop game (Microsoft.NET.Sdk) and the browser
    build (Microsoft.NET.Sdk.WebAssembly, RuntimeIdentifier browser-wasm), so the SDK is imported by hand
    and picked by RID. Shared settings (target framework, C# version, warnings as errors, RepoRoot) live in
    Directory.Build.props; package versions in Directory.Packages.props.
  -->

  <!-- ===== SDK selection (before Sdk.props) ===== -->

  <!-- The browser build keeps its restore and build output apart from the desktop build's. -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' == 'browser-wasm'">
    <BaseIntermediateOutputPath>obj/browser/</BaseIntermediateOutputPath>
    <BaseOutputPath>bin/browser/</BaseOutputPath>
  </PropertyGroup>

  <Import
    Project="Sdk.props"
    Sdk="Microsoft.NET.Sdk"
    Condition="'$(RuntimeIdentifier)' != 'browser-wasm'"
  />
  <Import
    Project="Sdk.props"
    Sdk="Microsoft.NET.Sdk.WebAssembly"
    Condition="'$(RuntimeIdentifier)' == 'browser-wasm'"
  />

  <!-- ===== General project settings ===== -->

  <PropertyGroup>
    <AssemblyName>StickAndPuck</AssemblyName>
    <RootNamespace>StickAndPuck.App</RootNamespace>
    <OutputType>Exe</OutputType>
    <!-- Published for Windows it is a GUI app with no console window; from a terminal it attaches to that console (GameLog). -->
    <OutputType Condition="$(RuntimeIdentifier.StartsWith('win-'))">WinExe</OutputType>
    <!-- Raylib interop passes pointers. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- JSON goes through source-generated contexts only (trimming-safe). -->
    <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
    <!-- obj/browser/ sits inside the project folder. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);obj/**</DefaultItemExcludes>
    <!-- Preview SDK notice. -->
    <NoWarn>$(NoWarn);NETSDK1057</NoWarn>
  </PropertyGroup>

  <!-- ===== Platform settings ===== -->

  <!-- Every RID-specific build carries its own runtime. -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">
    <SelfContained>true</SelfContained>
  </PropertyGroup>

  <!-- Desktop publish (linux-x64, win-x64, osx-arm64; see tools/publish.sh): one compressed executable with
       .NET, raylib and every asset inside. Windows also turns GUI above; macOS is wrapped in
       StickAndPuck.app afterwards by tools/macos_app.py. -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' != '' and '$(RuntimeIdentifier)' != 'browser-wasm'">
    <PublishSingleFile>true</PublishSingleFile>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <!-- Browser (browser-wasm): Mono on WebAssembly with raylib linked in natively, WebGL 1, trimmed. -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' == 'browser-wasm'">
    <DefineConstants>$(DefineConstants);BROWSER</DefineConstants>
    <UseMonoRuntime>true</UseMonoRuntime>
    <WasmBuildNative>true</WasmBuildNative>
    <EmccExtraLDFlags>-sMIN_WEBGL_VERSION=1 -sMAX_WEBGL_VERSION=1</EmccExtraLDFlags>
    <EmccVerbose>false</EmccVerbose>
    <PublishTrimmed>true</PublishTrimmed>
    <PublishSingleFile>false</PublishSingleFile>
    <UseAppHost>false</UseAppHost>
    <!-- This project selects its SDK by RID; nested static asset builds must retain it. -->
    <StaticWebAssetsAdditionalBuildPropertiesToRemove>$(StaticWebAssetsAdditionalBuildPropertiesToRemove.Replace('RuntimeIdentifier', ''))</StaticWebAssetsAdditionalBuildPropertiesToRemove>
    <StaticWebAssetsAdditionalPublishPropertiesToRemove>$(StaticWebAssetsAdditionalPublishPropertiesToRemove.Replace('RuntimeIdentifier', ''))</StaticWebAssetsAdditionalPublishPropertiesToRemove>
  </PropertyGroup>

  <!-- ===== Packages and native libraries ===== -->

  <!-- Raylib-cs brings the native raylib library for each desktop RID. -->
  <ItemGroup>
    <PackageReference Include="Raylib-cs" Version="8.1.0" />
  </ItemGroup>

  <!-- ===== Analyzers and source generators ===== -->

  <!-- The project's own analyzers and the DiscoveryGenerator (scene and game mode registry). -->
  <ItemGroup>
    <ProjectReference
      Include="$(RepoRoot)analyzers/StickAndPuck.Analyzers/StickAndPuck.Analyzers.csproj"
      OutputItemType="Analyzer"
      ReferenceOutputAssembly="false"
    />
  </ItemGroup>

  <!-- ===== Embedded assets ===== -->

  <!-- Every asset is packed into the assembly under its repository path (Core/Assets reads them). -->
  <ItemGroup>
    <!-- Shaders and game data (clubs, rules, language tables). -->
    <EmbeddedResource Include="$(RepoRoot)shaders/**" LinkBase="shaders" />
    <EmbeddedResource Include="$(RepoRoot)data/**/*.json" LinkBase="data" />

    <!-- Players, kits and the Zamboni. -->
    <EmbeddedResource
      Include="$(RepoRoot)art/player/*.glb;$(RepoRoot)art/player/*_64.png"
      LinkBase="art/player"
    />
    <EmbeddedResource Include="$(RepoRoot)art/kits/**/*.png" LinkBase="art/kits" />
    <EmbeddedResource Include="$(RepoRoot)art/zamboni/*.glb" LinkBase="art/zamboni" />

    <!-- Arena, ad boards and crowd. -->
    <EmbeddedResource
      Include="$(RepoRoot)art/scene/ice_scratches.png;$(RepoRoot)art/scene/*.glb;$(RepoRoot)art/scene/arena_meshes.json;$(RepoRoot)art/scene/exterior_meshes.json;$(RepoRoot)art/scene/crowd_seats.json"
      LinkBase="art/scene"
    />
    <EmbeddedResource Include="$(RepoRoot)art/ads/**/*.png" LinkBase="art/ads" />
    <EmbeddedResource
      Include="$(RepoRoot)art/crowd/*.png;$(RepoRoot)art/crowd/supporters.json"
      LinkBase="art/crowd"
    />
    <EmbeddedResource
      Include="$(RepoRoot)art/crowd/supporters/**/*.png"
      LinkBase="art/crowd/supporters"
    />

    <!-- Palette and UI. -->
    <EmbeddedResource Include="$(RepoRoot)art/palette/*.gpl" LinkBase="art/palette" />
    <EmbeddedResource
      Include="$(RepoRoot)art/ui/*.png;$(RepoRoot)art/ui/font.fnt;$(RepoRoot)art/ui/ui.json;$(RepoRoot)art/ui/intro_card.json"
      LinkBase="art/ui"
    />

    <!-- Sound effects and music. -->
    <EmbeddedResource Include="$(RepoRoot)art/audio/effects/*.wav" LinkBase="art/audio/effects" />
    <EmbeddedResource Include="$(RepoRoot)art/audio/music/*.wav" LinkBase="art/audio/music" />
  </ItemGroup>

  <!-- ===== SDK targets (picked like Sdk.props) ===== -->

  <Import
    Project="Sdk.targets"
    Sdk="Microsoft.NET.Sdk"
    Condition="'$(RuntimeIdentifier)' != 'browser-wasm'"
  />
  <Import
    Project="Sdk.targets"
    Sdk="Microsoft.NET.Sdk.WebAssembly"
    Condition="'$(RuntimeIdentifier)' == 'browser-wasm'"
  />
</Project>
