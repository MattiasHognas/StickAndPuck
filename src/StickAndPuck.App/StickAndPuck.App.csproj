<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0</TargetFramework>
    <LangVersion>15</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>StickAndPuck</AssemblyName>
    <RootNamespace>StickAndPuck.App</RootNamespace>
    <NoWarn>$(NoWarn);NETSDK1244;NETSDK1057</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="StickAndPuck.Tests" />
  </ItemGroup>

  <!-- dotnet publish -r linux-x64 (or win-x64) makes one self-contained executable: the runtime, raylib
       and every asset below are packed inside and unpacked on first start (tools/publish.sh) -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Raylib-cs" Version="8.1.0" />
  </ItemGroup>

  <!-- the game reads its assets next to the executable: shaders, models, kit atlases, ad strips, palette, club data -->
  <ItemGroup>
    <None Include="../../shaders/**" LinkBase="shaders" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../art/player/*.glb;../../art/player/*_64.png" LinkBase="art/player" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../art/ads/*.png" LinkBase="art/ads" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../art/kits/*.png" LinkBase="art/kits" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../art/kits/numbers/*.png" LinkBase="art/kits/numbers" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../art/scene/ice_scratches.png;../../art/scene/*.glb;../../art/scene/arena_meshes.json" LinkBase="art/scene" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../art/zamboni/*.glb" LinkBase="art/zamboni" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../art/palette/*.gpl" LinkBase="art/palette" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../art/ui/*.png;../../art/ui/font.fnt;../../art/ui/ui.json" LinkBase="art/ui" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../art/audio/*.wav" LinkBase="art/audio" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../data/**/*.json" LinkBase="data" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
